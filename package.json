{
	"name": "kobun",
	"version": "0.8.0",
	"description": "",
	"private": true,
	"type": "module",
	"author": "Ilango Rajagopal <hey@i4o.dev>",
	"license": "FSL-1.1-MIT",
	"engines": {
		"node": ">=24.11.0",
		"bun": ">=1.3.1"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.3.14",
			"onFail": "download"
		}
	},
	"scripts": {
		"build": "react-router build",
		"changeset": "changeset",
		"check": "biome check",
		"check:fix": "biome check --write",
		"check:types": "wrangler types && react-router typegen && tsc",
		"db:clean": "tsx ./packages/db/scripts/clean.ts",
		"db:doctor": "drizzle-kit up && drizzle-kit check",
		"db:drop": "drizzle-kit drop",
		"db:export": "drizzle-kit export > ./packages/db/schema.sql",
		"db:generate": "bun run db:generate:imports && drizzle-kit generate",
		"db:generate:imports": "bun ./packages/db/scripts/schema-imports.ts",
		"db:generate:reset": "rm -rf ./packages/db/migrations && bun run db:generate --name=init",
		"db:init": "tsx ./packages/db/scripts/init.ts",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:production": "CLOUDFLARE_ENV=production drizzle-kit migrate",
		"db:migrate:preview": "CLOUDFLARE_ENV=preview drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:remove": "rm -rf ./.wrangler/state/v3/d1",
		"db:seed": "tsx ./packages/db/scripts/seed.ts",
		"db:setup": "bun run db:remove && bun run db:init && bun run db:generate && bun run db:migrate && bun run db:seed",
		"db:studio": "drizzle-kit studio",
		"deploy:production": "CLOUDFLARE_ENV=production bun run build && wrangler deploy",
		"deploy:preview": "CLOUDFLARE_ENV=preview bun run build && wrangler deploy",
		"dev": "bun run generate:schema && bun run generate:manifest && NODE_OPTIONS=\"--inspect\" react-router dev",
		"doctor": "bun run check && bun run check:types && bun run test && bun run build",
		"generate:component": "bun run scripts/generate-component/generate.ts",
		"generate:manifest": "bun run scripts/generate-manifest.ts",
		"generate:schema": "bun run scripts/generate-schema.ts",
		"git:clean": "git branch -l | grep -v 'main' | xargs git branch -D",
		"git:reset": "rm -rf .git && git init .",
		"preview": "NODE_ENV=development bun run build && vite preview",
		"release:prepare": "./scripts/release-prepare.sh",
		"release:publish": "./scripts/release-publish.sh",
		"release:status": "changeset status",
		"setup": "bun install && bun run setup:env && react-router typegen && playwright install --with-deps chromium && bun run db:setup",
		"setup:env": "echo '# Put your secrets here' > .env",
		"setup:reset": "git clean -fdxq && bun run setup",
		"storybook": "storybook dev -p 6006 --no-open",
		"test": "bun run db:export && vitest run",
		"test:coverage": "bun run db:export && vitest run --coverage",
		"test:e2e": "playwright test --project=e2e",
		"test:e2e:ui": "playwright test --ui --project=e2e",
		"test:smoke": "playwright test --project=smoke",
		"test:watch": "bun run db:export && vitest watch",
		"version:release": "changeset version"
	},
	"dependencies": {
		"@base-ui/react": "1.3.0",
		"@better-auth/drizzle-adapter": "1.7.7",
		"@fontsource-variable/geist": "5.2.8",
		"@octokit/auth-app": "8.2.0",
		"@octokit/rest": "22.0.1",
		"@posthog/react": "1.10.3",
		"@tanstack/react-table": "8.21.3",
		"@tiptap/core": "3.31.4",
		"@tiptap/extension-character-count": "3.31.4",
		"@tiptap/extension-code-block-lowlight": "3.31.4",
		"@tiptap/extension-emoji": "3.31.4",
		"@tiptap/extension-link": "3.31.4",
		"@tiptap/extension-placeholder": "3.31.4",
		"@tiptap/extension-text-style": "3.31.4",
		"@tiptap/extension-typography": "3.31.4",
		"@tiptap/extension-underline": "3.31.4",
		"@tiptap/markdown": "3.31.4",
		"@tiptap/pm": "3.31.4",
		"@tiptap/react": "3.31.4",
		"@tiptap/starter-kit": "3.31.4",
		"@tiptap/suggestion": "3.31.4",
		"autosendjs": "1.0.5",
		"better-auth": "1.6.24",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"cmdk": "1.1.1",
		"date-fns": "4.1.0",
		"drizzle-orm": "0.45.3",
		"gray-matter": "4.0.3",
		"isbot": "5.1.37",
		"lowlight": "3.3.0",
		"lucide-react": "0.577.0",
		"marked": "^17.0.6",
		"posthog-js": "1.407.2",
		"posthog-node": "5.46.1",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-router": "8.4.0",
		"shadcn": "3.8.5",
		"tailwind-merge": "3.5.0",
		"tiny-invariant": "1.3.3",
		"tippy.js": "6.3.7",
		"tw-animate-css": "1.4.0",
		"yaml": "2.8.3",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@better-auth/cli": "1.4.21",
		"@biomejs/biome": "2.3.10",
		"@changesets/cli": "2.31.1",
		"@cloudflare/vite-plugin": "1.62.5",
		"@dotenvx/dotenvx": "1.51.4",
		"@faker-js/faker": "10.5.0",
		"@playwright/test": "1.57.0",
		"@react-router/dev": "8.4.0",
		"@storybook/addon-docs": "10.2.15",
		"@storybook/addon-themes": "10.2.15",
		"@storybook/react-vite": "10.6.1",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "4.2.2",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.7",
		"@types/better-sqlite3": "7.6.13",
		"@types/bun": "1.3.1",
		"@types/node": "24.10.4",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitest/coverage-v8": "4.1.10",
		"better-sqlite3": "13.0.3",
		"commander": "14.0.3",
		"drizzle-kit": "0.31.11",
		"fast-glob": "3.3.3",
		"happy-dom": "20.0.11",
		"rollup-plugin-visualizer": "6.0.5",
		"storybook": "10.6.1",
		"tailwindcss": "4.1.18",
		"tsx": "4.21.0",
		"typescript": "5.9.3",
		"vite": "8.1.5",
		"vitest": "4.1.10",
		"wrangler": "4.147.0"
	},
	"trustedDependencies": [
		"@tailwindcss/oxide",
		"better-sqlite3",
		"esbuild",
		"sharp",
		"workerd"
	]
}
