# Local tooling and build-time variables.
#
# Nothing here reaches the Worker at runtime - runtime secrets and bindings
# belong in .dev.vars / wrangler.json instead. See .dev.vars.example.

# Cloudflare CLI
#
# Read via process.env by drizzle-kit and wrangler (packages/db/utils.ts).
# Local and CI only; the Worker never sees these. In CI they come from GitHub
# Actions repository secrets/variables.
# Create a token at https://dash.cloudflare.com/profile/api-tokens with
# D1:Edit and Workers Scripts:Edit permissions.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Build-time
#
# Vite inlines every VITE_-prefixed variable into the bundle at build time, so
# these are baked into the JavaScript users download. Public values only -
# never put a secret here.
#
# Because they are resolved at build time, setting them as Cloudflare vars or
# secrets has no effect. In CI they are passed to the Build step from GitHub
# Actions variables.

# Kobun
VITE_KOBUN_HOME_URL=https://kobun.io
VITE_KOBUN_APP_URL=https://app.kobun.io

# PostHog
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=
