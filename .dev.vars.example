# Worker runtime secrets.
#
# These reach the app as `env.*` bindings (see app/core/context.ts). Locally
# they come from .dev.vars; in deployed environments they are Cloudflare
# secrets, set with `wrangler secret put <NAME> --env <production|preview>` or
# in the dashboard under Workers & Pages -> <worker> -> Settings ->
# Variables and Secrets.
#
# Non-secret runtime config (BETTER_AUTH_URL, GITHUB_APP_ID, GITHUB_APP_SLUG)
# lives in wrangler.json under `vars` for deployed environments - the copies
# here only apply to local development.
#
# Build-time variables belong in .env instead - see .env.example.

# AutoSend Email
AUTOSEND_API_KEY=
AUTOSEND_LIST_ID=

# Base URL of your app
BETTER_AUTH_URL=http://localhost:5173
# Generate a secure secret: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
# Convert the PEM file to a single-line value
# awk 'NR==1{printf "%s",$0; next}{printf "\\n%s",$0}' ~/path-to/kobun.private-key.pem | pbcopy
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SLUG=
