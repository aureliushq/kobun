{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kobun",
	"compatibility_date": "2025-08-23",
	"compatibility_flags": ["nodejs_compat"],
	"main": "workers/index.ts",
	"assets": {
		"directory": "./build/client",
		"binding": "ASSETS",
		"run_worker_first": ["/manifest.json", "/schemas/v1.json"]
	},
	"preview_urls": true,
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"secrets": {
		"required": [
			"AUTOSEND_API_KEY",
			"AUTOSEND_LIST_ID",
			"BETTER_AUTH_SECRET",
			"GITHUB_CLIENT_ID",
			"GITHUB_CLIENT_SECRET",
			"GITHUB_APP_PRIVATE_KEY",
			"GITHUB_APP_WEBHOOK_SECRET"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "kobun-development",
			"database_id": "<DATABASE_ID>"
		}
	],
	"vars": {
		"BETTER_AUTH_URL": "http://localhost:5173",
		"GITHUB_APP_ID": "3006163",
		"GITHUB_APP_SLUG": "kobun-local"
	},
	"env": {
		"production": {
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "kobun-production",
					"database_id": "97ff3659-f488-4522-b4d4-4d16a0b325ec"
				}
			],
			"vars": {
				"BETTER_AUTH_URL": "https://app.kobun.io",
				"GITHUB_APP_ID": "3211939",
				"GITHUB_APP_SLUG": "kobun-cms"
			}
		},
		"preview": {
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "kobun-preview",
					"database_id": "faa93bcf-9d7c-4351-9d49-cba75f6e572e"
				}
			],
			"vars": {
				"BETTER_AUTH_URL": "https://dev.app.kobun.io",
				"GITHUB_APP_ID": "3017727",
				"GITHUB_APP_SLUG": "kobun-preview"
			}
		},
		"test": {
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "kobun-development",
					"database_id": "<DATABASE_ID>"
				}
			],
			"vars": {
				"AUTOSEND_API_KEY": "",
				"AUTOSEND_LIST_ID": "",
				"BETTER_AUTH_URL": "",
				"BETTER_AUTH_SECRET": "",
				"GITHUB_CLIENT_ID": "",
				"GITHUB_CLIENT_SECRET": "",
				"GITHUB_APP_ID": "",
				"GITHUB_APP_PRIVATE_KEY": "",
				"GITHUB_APP_WEBHOOK_SECRET": "",
				"GITHUB_APP_SLUG": ""
			}
		}
	}
}
